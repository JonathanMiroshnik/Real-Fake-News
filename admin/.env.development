# Committed on purpose — safe, secret-free defaults for `npm run dev`.
# Vite loads .env.development automatically in dev mode, so a fresh clone works
# with no setup and can never silently fall back to the production API.
#
# Personal overrides: create admin/.env.development.local (gitignored).
# Precedence (low -> high): .env  <  .env.development  <  .env.local  <  .env.development.local
VITE_BACKEND_DEV_MODE=true
VITE_USE_RELATIVE_API=false
VITE_API_BASE_DEV=http://localhost:5001
VITE_FRONTEND_DEV_MODE=true
VITE_CLIENT_URL_DEV=http://localhost:5173
VITE_PORT=5174
