# Dependencies
node_modules/

# Environment files (never committed)
# Root .env  -> Docker Compose only (secrets for the server container)
# */..env    -> per-app secrets for running an app directly on the host
# *.local    -> personal overrides (highest Vite priority, never committed)
.env
.env.local
.env.*.local
admin/.env
server/.env
client/.env

# Build outputs
dist/
build/
server/dist/
client/dist/
admin/build/
*.log

# Database files (generated at runtime, mounted as Docker volume)
*.sqlite
*.sqlite-wal
*.sqlite-shm
database.db*
database/database.db*
database/images/
database/images/compressed/
# Runtime volume only — anchored, because an unanchored `database/` also matched
# `server/src/lib/database/`, which silently dropped newly added files there
# (an untracked test file was invisible to `git add .`). Sibling of the rule below.
/database/

# Database volume mount directory on host (Docker)
/database/

# Old server/data location (no longer used - data is now in database/)
server/data/

# OS files
.DS_Store
Thumbs.db

# SvelteKit artifacts in admin (legacy)
admin/.svelte-kit/

# Test artifacts
coverage/
playwright-report/
test-results/
*.tsbuildinfo