# =============================================================================
# root .env — the ONLY env file Docker Compose reads
# =============================================================================
# Copy to .env (gitignored):   cp .env.example .env
#
# Who reads this file?
#   1. Docker Compose — interpolates ${VARS} in docker-compose.yml (and .dev.yml)
#   2. the server container — passed through as env_file: .env
#
# The three apps stay independently runnable and do NOT read this file when you
# run them directly on the host. For that, each app has its own file:
#   server/.env              -> npm run dev / npm start   (loaded by dotenv)
#   client/.env.development  -> npm run dev               (committed, no secrets)
#   admin/.env.development   -> npm run dev               (committed, no secrets)
# See docs/configuration.md for the full matrix.
#
# Values marked (:?) in docker-compose.yml are REQUIRED — `docker compose config`
# fails with a readable message until you fill them in.
# =============================================================================

# =============================================================================
# REQUIRED — API keys & admin password (no defaults, no placeholders in prod)
# =============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here
RUNWARE_API_KEY=your_runware_api_key_here

# Admin panel password. Used by the server to authorise admin requests.
ADMIN_PASSWORD=changeme123

# =============================================================================
# SERVER RUNTIME — optional overrides (defaults in parentheses)
# =============================================================================

# Origin of the public frontend. Used for CORS and for absolute links the API
# returns. (https://real.sensorcensor.xyz)
CLIENT_URL=https://real.sensorcensor.xyz

# Comma-separated EXTRA CORS origins, on top of the built-in defaults
# (https://real.sensorcensor.xyz, http://localhost:5173, http://localhost:5174).
# Use this when you host the frontend on a new domain without touching code.
# ALLOWED_ORIGINS=https://staging.example.com

# Background jobs: news fetching + article generation (true)
ENABLE_SCHEDULED_JOBS=true

# Placeholder content when the database is empty (false)
# Dev content comes from the `seed` service (`npm run seed:dev`); this read-time
# fallback stays off so production never invents content.
ENABLE_FAKE_DATA=false

# Verbose server logging (false)
DEBUG_LOGS=false

# Runware image model used for generated article images (runware:z-image@turbo)
RUNWARE_IMAGE_MODEL=runware:z-image@turbo

# =============================================================================
# DATA LOCATION — where the SQLite file + generated images live on the HOST
# =============================================================================
# Read by docker-compose.yml only (the bind mounts). The app inside the container
# always sees /data/database.db and /images, whatever these say.
#
# BOTH keys are required and neither has a built-in default: `docker compose up`
# refuses to start when one is missing, so data can never silently land inside
# the repo. Any directory works — relative values resolve against the repo root,
# absolute paths are fine too. The compose files mount them with `:z`, which
# relabels the host path for SELinux on every start, so a path under /home is
# fine (this matters on Fedora: `user_home_t` is not writable by containers):
#   DATABASE_DIR=./database              # inside the repo (gitignored)
#   DATABASE_DIR=/var/lib/rfnews         # typical VPS location
#   DATABASE_DIR=/mnt/ssd/rfnews-data    # second disk
#
# Migrating: stop the stack, copy the files over, change this value, start again:
#   docker compose down
#   rsync -a ./database/ /var/lib/rfnews/
#   DATABASE_DIR=/var/lib/rfnews docker compose up -d
DATABASE_DIR=./database

# Images directory (originals + compressed copies) — required, no default.
# Splitting it onto its own disk / quota / backup cycle is worth it, images grow
# fast (one JPEG pair per article):
#   IMAGES_DIR=/var/lib/rfnews/images
#   IMAGES_DIR=/mnt/big-disk/rfnews-images
IMAGES_DIR=./database/images

# =============================================================================
# SERVER — set by docker-compose.yml, listed here for reference only
# =============================================================================
# NODE_ENV=production          # compose sets this per file (dev override = development)
# PORT=5001                    # container-internal port, never exposed on the VPS
# DATABASE_PATH=/data/database.db   # container-side path; host side = DATABASE_DIR
# IMAGES_PATH=/images               # container-side path; host side = IMAGES_DIR

# =============================================================================
# SERVER — optional / reserved (read by code, but not needed for a normal run)
# =============================================================================
# JWT_SECRET=               # used by the auth helpers; leave unset unless auth is enabled
# GOOGLE_CLIENT_ID=         # used by the Google login helper
# FAKE_IMAGE_WIDTH=896
# FAKE_IMAGE_HEIGHT=512
# FAKE_IMAGE_TILES_X=8
# FAKE_IMAGE_TILES_Y=6
# FAKE_IMAGE_COLOR_MIN_R=30
# FAKE_IMAGE_COLOR_MAX_R=225
# FAKE_IMAGE_COLOR_MIN_G=30
# FAKE_IMAGE_COLOR_MAX_G=225
# FAKE_IMAGE_COLOR_MIN_B=30
# FAKE_IMAGE_COLOR_MAX_B=225

# =============================================================================
# SPA BUILD CONFIG — baked into client/ and admin/ at image build time
# =============================================================================
# ⚠️ These are PUBLIC values (anyone can read them in the JS bundle). Never put
#    secrets here. Changing one requires a rebuild:
#      docker compose build client admin

# Use nginx-relative "/api" URLs (recommended inside Docker: same origin, no CORS)
VITE_USE_RELATIVE_API=true

# false + VITE_USE_RELATIVE_API=true -> use the PROD base URL below (the compose
# service name). Set to true only for a host-run backend (see client/.env.development)
VITE_BACKEND_DEV_MODE=false
VITE_API_BASE_DEV=http://localhost:5001
VITE_API_BASE_PROD=http://server:5001

# Debug console logging in the browser (false in production)
VITE_DEBUG_LOGS=false

# Homepage feature flags
VITE_SHOW_HOROSCOPES=true
VITE_SHOW_RECIPES=true

# How long the client caches articles before refetching, in ms
VITE_ARTICLES_CACHE_EXPIRATION_MS=600000

# ADMIN ONLY — article links built for the public site
VITE_FRONTEND_DEV_MODE=false
VITE_CLIENT_URL_DEV=http://localhost:5173
VITE_CLIENT_URL_PROD=https://real.sensorcensor.xyz
