# =============================================================================
# client/.env.example — reference for the client SPA configuration
# =============================================================================
# ⚠️ You usually do NOT need a .env file here.
#    - Running on the host (npm run dev): client/.env.development is committed
#      with working, secret-free defaults and is loaded automatically.
#    - Running in Docker: set these keys in the ROOT .env; docker-compose.yml
#      passes them to the image as build args.
#
# Personal overrides: create client/.env.development.local (gitignored).
# Precedence (low -> high): .env < .env.development < .env.local < .env.development.local
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it bakes
# them into the bundle at BUILD time — they are public, never put secrets here.
# =============================================================================

# Use nginx-relative "/api" URLs (true in Docker, where the SPA's own nginx
# proxies /api to the server container)
VITE_USE_RELATIVE_API=false

# true  -> talk to VITE_API_BASE_DEV (host-run backend, e.g. localhost:5001)
# false -> talk to VITE_API_BASE_PROD (container/DNS name, e.g. server:5001)
# ⚠️ If this is undefined the app falls back to the PRODUCTION url in
#    client/src/config/apiConfig.ts — that is why .env.development exists.
VITE_BACKEND_DEV_MODE=true

# Backend base URLs (only used when VITE_USE_RELATIVE_API=false)
VITE_API_BASE_DEV=http://localhost:5001
VITE_API_BASE_PROD=http://server:5001

# Debug logging in the browser console
VITE_DEBUG_LOGS=true

# Homepage feature flags (compared against the string 'true')
VITE_SHOW_HOROSCOPES=true
VITE_SHOW_RECIPES=true

# Article cache lifetime in ms before the client refetches (600000 = 10 min)
VITE_ARTICLES_CACHE_EXPIRATION_MS=600000

# Delay in ms before the "no articles" message appears (3000)
# VITE_NO_ARTICLES_MESSAGE_DELAY=3000

# Reserved: Google sign-in button (only used by commented-out code)
# VITE_GOOGLE_CLIENT_ID=
