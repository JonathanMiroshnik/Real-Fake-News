# =============================================================================
# server/.env.example — configuration for running the API ON THE HOST
# =============================================================================
# Used by:  cd server && npm run dev        (dotenv loads server/.env)
#           cd server && npm start
#
# NOT used by Docker Compose. The containers read the ROOT .env instead
# (see /docker-compose.yml -> env_file: .env). Both files take the same keys.
#
# The file is looked up next to this app (server/.env), NOT in the current
# working directory, so you can start the server from anywhere.
#
# Copy:  cp server/.env.example server/.env
# =============================================================================

# =============================================================================
# REQUIRED — API keys & admin password
# =============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here
RUNWARE_API_KEY=your_runware_api_key_here

# Admin panel password (CHANGE THIS — the code falls back to "changeme123")
ADMIN_PASSWORD=changeme123

# =============================================================================
# OPTIONAL — server behaviour
# =============================================================================

# HTTP port (5001)
# PORT=5001

# Public frontend origin, used for CORS and absolute links (http://localhost:5173)
# CLIENT_URL=http://localhost:5173

# Extra CORS origins, comma-separated, added to the built-in defaults
# (https://real.sensorcensor.xyz, http://localhost:5173, http://localhost:5174)
# ALLOWED_ORIGINS=https://staging.example.com

# Background jobs: news fetching + article generation (false when unset)
# ⚠️ With real API keys this costs money — keep it false for local development
# ENABLE_SCHEDULED_JOBS=false

# Placeholder content when the database is empty (false when unset)
# ENABLE_FAKE_DATA=true

# Verbose server logging (false when unset)
# DEBUG_LOGS=false

# Runware model for generated images (runware:z-image@turbo)
# RUNWARE_IMAGE_MODEL=runware:z-image@turbo

# =============================================================================
# OPTIONAL — data location
# =============================================================================
# Default: <repo>/database/database.db (sibling of server/, resolved from the
# source file, not from the working directory). Absolute paths are used as-is,
# so this app can run standalone with its data anywhere on the machine:
#   DATABASE_PATH=/var/lib/rfnews/database.db
# A relative value resolves against server/ (never against the shell's cwd).
# DATABASE_PATH=../database/database.db

# Images directory. Default: dirname(DATABASE_PATH)/images, i.e. images follow the
# database. Set it to keep images somewhere else (own disk, separate backup):
#   IMAGES_PATH=/mnt/big-disk/rfnews-images
# Same rules as DATABASE_PATH: absolute as-is, relative against server/.
# IMAGES_PATH=../database/images

# =============================================================================
# OPTIONAL — reserved (read by code, not needed for a normal run)
# =============================================================================
# JWT_SECRET=
# GOOGLE_CLIENT_ID=

# =============================================================================
# OPTIONAL — fake image generator (tiled-colour placeholders)
# =============================================================================
# FAKE_IMAGE_WIDTH=896
# FAKE_IMAGE_HEIGHT=512
# FAKE_IMAGE_TILES_X=8
# FAKE_IMAGE_TILES_Y=6
# FAKE_IMAGE_COLOR_MIN_R=30
# FAKE_IMAGE_COLOR_MAX_R=225
# FAKE_IMAGE_COLOR_MIN_G=30
# FAKE_IMAGE_COLOR_MAX_G=225
# FAKE_IMAGE_COLOR_MIN_B=30
# FAKE_IMAGE_COLOR_MAX_B=225
